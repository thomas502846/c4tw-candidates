# c4twweb production 環境變數（server 上複製為 .env.production 後填值）
# cp .env.production.example .env.production && vim .env.production
# ⚠️ .env.production 含秘密，只放在 server，不進 git、不被 rsync 覆蓋。

# --- 必填 ---

# RDS PostgreSQL（密碼見 docs/infra/PROVISION_20260612.md）
# RDS PG16 預設 rds.force_ssl=1：DATABASE_URI 必須帶 sslmode（staging 用 no-verify；正式建議 verify-full + RDS CA bundle）
DATABASE_URI=postgresql://c4twweb:CHANGE_ME@c4twweb-db.c50860o4a63l.ap-northeast-2.rds.amazonaws.com:5432/c4twweb?sslmode=no-verify

# Payload JWT 加密（openssl rand -hex 32；正式環境用獨立值，勿沿用本機 dev）
PAYLOAD_SECRET=CHANGE_ME

# 對外網址（無尾斜線）。staging 階段用 staging 網域；正式切換後改 https://carefortaiwan.com.tw
NEXT_PUBLIC_SERVER_URL=https://staging.carefortaiwan.com.tw

# staging：true = X-Robots-Tag noindex + robots.txt 全站 disallow。正式上線改 false。
NOINDEX=true

# --- S3 媒體儲存（設了 S3_BUCKET 才會啟用 @payloadcms/storage-s3） ---
S3_BUCKET=c4twweb-media
S3_REGION=ap-northeast-2
# IAM user c4twweb-deploy 的 access key（不設則走 instance/default credential chain）
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME

# --- 聯絡表單（SES 寄信） ---
# SES 用 AWS_REGION（沒設則 code fallback ap-northeast-2）；credential 同上走 AWS_* 或 default chain
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# 寄件人，需先在 SES 完成 mail.carefortaiwan.com.tw 網域驗證
SES_FROM_ADDRESS=no-reply@mail.carefortaiwan.com.tw
# true = 不真寄信只印 log（SES 網域驗證完成前先開著）
SES_DRY_RUN=true
# site-settings 沒設定收件信箱時的 fallback（可逗號分隔多個）
CONTACT_FALLBACK_TO=thomas502846@gmail.com

# --- 其他 ---

# cron / jobs endpoint 驗證
CRON_SECRET=CHANGE_ME

# live preview 驗證
PREVIEW_SECRET=CHANGE_ME

# --- Google Maps Embed API（聯絡頁地圖；免費、不計次）---
# 取得：Google Cloud Console → 啟用「Maps Embed API」→ 建立 API key →
#   建議限制 HTTP referrer 為 carefortaiwan.com.tw / staging.carefortaiwan.com.tw / localhost。
# 未設定時前台自動退回免金鑰的 output=embed 嵌入（仍可顯示）。
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
