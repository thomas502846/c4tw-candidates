# Database connection string (local dev: docker container c4twweb-pg, port 5433)
# docker run -d --name c4twweb-pg -p 5433:5432 -e POSTGRES_PASSWORD=c4twweb -e POSTGRES_DB=c4twweb postgres:16
DATABASE_URI=postgresql://postgres:c4twweb@localhost:5433/c4twweb

# Used to encrypt JWT tokens (generate with: openssl rand -hex 32)
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# --- 聯絡表單（SES 寄信） ---
# site-settings 沒設定收件信箱時的 fallback（可逗號分隔多個）
CONTACT_FALLBACK_TO=thomas502846@gmail.com
# SES 寄件人，需在 mail.carefortaiwan.com.tw 網域完成驗證
SES_FROM_ADDRESS=no-reply@mail.carefortaiwan.com.tw
# true = 不真寄信，只把 payload 印到 server log（本機/E2E 測試用）；正式環境設 false 或拿掉
SES_DRY_RUN=false
